{
  "name": "auge-management-system-ref",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run db:generate && next dev",
    "postinstall": "pnpm run db:generate",
    "build": "pnpm run db:migrate:deploy && pnpm run build:ci",
    "build:ci": "pnpm run db:generate && next build",
    "build:preview": "pnpm run build",
    "start": "next start",
    "lint": "biome check",
    "typecheck": "pnpm run db:generate && tsc --noEmit",
    "test": "node --test tests/mutations.test.mjs tests/check-in.test.mjs tests/sidebar-navigation.test.mjs tests/auth-preview.test.mjs",
    "cron:arrivals": "node tools/arrival-cron.mjs",
    "format": "biome format --write",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:workflows": "tsx prisma/seed-workflows.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.11",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@zxing/browser": "^0.2.1",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.76.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "daisyui": "^5.7.47",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
